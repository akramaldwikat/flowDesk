# Reference only. Enter secrets privately in provider settings, never in this file.
# See docs/deployment.md for the separate Web/API matrix.
NODE_ENV=production
APP_MODE=demo
WEB_ORIGIN=https://ACTUAL_WEB_HOST.onrender.com
# Web only. Historical variable name now refers to the public HTTPS API.
API_INTERNAL_URL=https://ACTUAL_API_HOST.onrender.com
# Both servers: same private random value, never NEXT_PUBLIC_.
PROXY_SECRET=REPLACE_WITH_PRIVATE_RANDOM_48_BYTE_VALUE
# API only. Dedicated direct Neon Free connection, verified TLS.
DATABASE_URL=postgresql://ROLE:REPLACE_PRIVATE_PASSWORD@ACTUAL_DIRECT_HOST.neon.tech/flowdesk_demo?sslmode=verify-full
DEMO_DATABASE_HOST=ACTUAL_DIRECT_HOST.neon.tech
DEMO_DATABASE_NAME=flowdesk_demo
JWT_SECRET=REPLACE_WITH_DIFFERENT_PRIVATE_RANDOM_48_BYTE_VALUE
TRUST_PROXY=false
# Render supplies PORT. Wrapper sets API_BIND_HOST=0.0.0.0 and API_PORT=PORT.
# Never set TEST_DATABASE_URL, local DEMO_PASSWORD or maintenance passwords in runtime.
# Owner CLI only: DEMO_ADMIN_PASSWORD, DEMO_MANAGER_PASSWORD and DEMO_MEMBER_PASSWORD supplied privately.
