# Reference only. Populate the hosting provider's secret environment, not this file.
# This template DOES NOT enable safe public demo access. Read docs/demo-strategy.md.
NODE_ENV=production
WEB_ORIGIN=https://flowdesk.example
DATABASE_URL=postgresql://ROLE:REPLACE_PRIVATE_PASSWORD@PRIVATE_DATABASE_HOST:5432/flowdesk_demo
JWT_SECRET=REPLACE_WITH_A_NEW_RANDOM_SECRET_AT_LEAST_48_BYTES
API_BIND_HOST=0.0.0.0
API_PORT=10000
API_INTERNAL_URL=http://flowdesk-api:10000
# false is fail-closed for client-IP trust; keep it until the ingress chain is verified.
TRUST_PROXY=false
# Never configure DEMO_PASSWORD or TEST_DATABASE_URL in the production runtime.
